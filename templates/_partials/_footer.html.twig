<footer class="landing-footer pt-5 pb-4 border-top bg-white">
    <div class="container">
        <div class="row g-4 mb-4">
            <div class="col-lg-5">
                <a class="footer-brand fw-bold text-dark text-decoration-none fs-5" href="{{ path('app_home') }}">
                    <i class="bi bi-activity text-success"></i> Kabivox
                </a>
                <p class="text-secondary small mt-2 mb-0" style="max-width: 320px">
                    Monitoring, incidents et page de statut publique pour les sites et API des PME et des agences web.
                </p>
            </div>
            <div class="col-6 col-lg-2">
                <h2 class="h6 fw-bold">Produit</h2>
                <ul class="list-unstyled small">
                    <li><a href="{{ path('app_home') }}#fonctionnement">Comment ça marche</a></li>
                    <li><a href="{{ path('app_home') }}#tarifs">Tarifs</a></li>
                    <li><a href="{{ path('app_home') }}#faq">Questions fréquentes</a></li>
                    {% if demo_slug|default(null) %}
                        <li><a href="{{ path('app_status_page', {slug: demo_slug}) }}">Page de démo</a></li>
                    {% endif %}
                </ul>
            </div>
            <div class="col-6 col-lg-2">
                <h2 class="h6 fw-bold">Compte</h2>
                <ul class="list-unstyled small">
                    {% if app.user %}
                        <li><a href="{{ path('app_dashboard') }}">Dashboard</a></li>
                    {% else %}
                        <li><a href="{{ path('app_register') }}">Créer un compte</a></li>
                        <li><a href="{{ path('app_login') }}">Connexion</a></li>
                    {% endif %}
                </ul>
            </div>
            <div class="col-6 col-lg-3">
                <h2 class="h6 fw-bold">Légal</h2>
                <ul class="list-unstyled small">
                    <li><a href="{{ path('app_legal_notice') }}">Mentions légales</a></li>
                    <li><a href="{{ path('app_legal_terms') }}">Conditions d'utilisation</a></li>
                    <li><a href="{{ path('app_legal_privacy') }}">Confidentialité</a></li>
                </ul>
            </div>
        </div>
        <div class="border-top pt-3 small text-secondary">
            © {{ 'now'|date('Y') }} Kabivox
        </div>
    </div>
</footer>
