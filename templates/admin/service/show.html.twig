{% extends 'base.html.twig' %}
{% import '_partials/_macros.html.twig' as ui %}

{% block title %}{{ service.name }}{% endblock %}

{% block body %}
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_project_show', {id: project.id}) }}">{{ project.name }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ service.name }}</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-4">
        <div>
            <h1 class="h3 mb-1 d-flex align-items-center gap-2">
                {{ service.name }} {{ ui.service_status_badge(service.currentStatus) }}
            </h1>
            <code class="small">{{ service.httpMethod.value }} {{ service.url }}</code>
        </div>
        <div class="d-flex gap-2">
            <form method="post" action="{{ path('app_service_toggle', {id: service.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('toggle-service-' ~ service.id) }}">
                {% if service.active %}
                    <button class="btn btn-outline-secondary"><i class="bi bi-pause-fill"></i> Mettre en pause</button>
                {% else %}
                    <button class="btn btn-outline-success"><i class="bi bi-play-fill"></i> Reprendre</button>
                {% endif %}
            </form>
            <a href="{{ path('app_service_edit', {id: service.id}) }}" class="btn btn-outline-secondary"><i class="bi bi-pencil"></i> Modifier</a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3"><div class="card p-3"><div class="small text-secondary">Fréquence</div><div class="fw-semibold">{{ service.checkInterval.label }}</div></div></div>
        <div class="col-6 col-lg-3"><div class="card p-3"><div class="small text-secondary">Code attendu</div><div class="fw-semibold">{{ service.expectedStatusCode }}</div></div></div>
        <div class="col-6 col-lg-3"><div class="card p-3"><div class="small text-secondary">Seuil dégradé</div><div class="fw-semibold">{{ service.degradedThresholdMs }} ms</div></div></div>
        <div class="col-6 col-lg-3"><div class="card p-3"><div class="small text-secondary">Prochaine vérification</div><div class="fw-semibold">{{ service.nextCheckAt ? service.nextCheckAt|date('H:i') : (service.active ? 'Imminente' : '—') }}</div></div></div>
    </div>

    <div class="card">
        <div class="card-header bg-white fw-semibold">Dernières vérifications</div>
        {% if latest_checks is empty %}
            <div class="card-body text-center text-secondary py-5">
                Aucune vérification pour l'instant. Le moteur de monitoring sera branché en semaine 2.
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>Date</th><th>Résultat</th><th>Code HTTP</th><th>Temps de réponse</th><th>Erreur</th></tr>
                    </thead>
                    <tbody>
                        {% for check in latest_checks %}
                            <tr>
                                <td class="small">{{ check.checkedAt|date('d/m/Y H:i:s') }}</td>
                                <td>{{ ui.status_dot(check.up ? 'success' : 'danger') }}</td>
                                <td>{{ check.statusCode ?? '—' }}</td>
                                <td>{{ check.responseTimeMs is not null ? check.responseTimeMs ~ ' ms' : '—' }}</td>
                                <td class="small text-danger">{{ check.errorMessage }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endblock %}
