{% extends 'base.html.twig' %}

{% block title %}Déclarer un incident — {{ project.name }}{% endblock %}

{% block body %}
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_project_show', {id: project.id}) }}">{{ project.name }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_incident_index', {projectId: project.id}) }}">Incidents</a></li>
            <li class="breadcrumb-item active" aria-current="page">Déclarer</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-lg-7">
            <div class="card p-4">
                <h1 class="h4 mb-4">Déclarer un incident</h1>
                {{ form_start(form) }}
                    {{ form_row(form.title) }}
                    <div class="row">
                        <div class="col-sm-6">{{ form_row(form.impact) }}</div>
                        <div class="col-sm-6">{{ form_row(form.status) }}</div>
                    </div>
                    {{ form_row(form.affectedServices) }}
                    {{ form_row(form.message) }}
                    <button class="btn btn-danger" type="submit">Publier l'incident</button>
                    <a href="{{ path('app_incident_index', {projectId: project.id}) }}" class="btn btn-link">Annuler</a>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
