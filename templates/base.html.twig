<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Kabivox{% endblock %} · Kabivox</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 16 16%22><circle cx=%228%22 cy=%228%22 r=%227%22 fill=%22%23198754%22/></svg>">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {% block navbar %}
            {{ include('_partials/_navbar.html.twig') }}
        {% endblock %}

        <main class="py-4">
            <div class="container">
                {{ include('_partials/_flashes.html.twig') }}
                {% block body %}{% endblock %}
            </div>
        </main>

        <footer class="py-4 text-center text-secondary small border-top bg-white">
            Kabivox · Projet portfolio Symfony
        </footer>
    </body>
</html>
