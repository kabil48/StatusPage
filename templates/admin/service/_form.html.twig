{{ form_start(form) }}
    <div class="row">
        <div class="col-md-6">{{ form_row(form.name) }}</div>
        <div class="col-md-6">{{ form_row(form.checkInterval) }}</div>
    </div>
    <div class="row">
        <div class="col-md-3">{{ form_row(form.httpMethod) }}</div>
        <div class="col-md-9">{{ form_row(form.url) }}</div>
    </div>

    <h2 class="h6 mt-3 mb-3 text-secondary text-uppercase small">Règles de détection</h2>
    <div class="row">
        <div class="col-md-4">{{ form_row(form.expectedStatusCode) }}</div>
        <div class="col-md-4">{{ form_row(form.timeoutSeconds) }}</div>
        <div class="col-md-4">{{ form_row(form.position) }}</div>
    </div>
    <div class="row">
        <div class="col-md-6">{{ form_row(form.degradedThresholdMs) }}</div>
        <div class="col-md-6">{{ form_row(form.failureThreshold) }}</div>
    </div>

    {{ form_row(form.isPublic) }}

    <button class="btn btn-success" type="submit">{{ button_label }}</button>
{{ form_end(form) }}
