{% extends 'base.html.twig' %}

{# Les passages marqués .todo doivent être complétés avant la mise en production. #}
{% block body %}
    <article class="legal-content card p-4 p-lg-5 mx-auto" style="max-width: 820px">
        <h1 class="h2 fw-bold mb-1">{{ block('title') }}</h1>
        <p class="text-secondary small">Dernière mise à jour : <span class="todo">[date]</span></p>
        {% block legal_content %}{% endblock %}
    </article>
{% endblock %}
