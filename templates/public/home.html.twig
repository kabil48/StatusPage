{% extends 'base.html.twig' %}

{% block title %}Surveillez vos services{% endblock %}

{% block body %}
    <section class="hero text-center">
        <h1 class="display-5 fw-bold mb-3">Vos services sont-ils en ligne&nbsp;?</h1>
        <p class="lead text-secondary mb-4 mx-auto" style="max-width: 640px">
            StatusPage vérifie automatiquement vos sites et API, détecte les pannes,
            ouvre les incidents et publie une page de statut pour vos utilisateurs.
        </p>
        <div class="d-flex justify-content-center gap-2">
            {% if app.user %}
                <a href="{{ path('app_dashboard') }}" class="btn btn-success btn-lg">Accéder au dashboard</a>
            {% else %}
                <a href="{{ path('app_register') }}" class="btn btn-success btn-lg">Commencer gratuitement</a>
                <a href="{{ path('app_login') }}" class="btn btn-outline-secondary btn-lg">Se connecter</a>
            {% endif %}
        </div>
    </section>

    <section class="row g-4 pb-5">
        {% for feature in [
            {icon: 'bi-broadcast', title: 'Monitoring automatique', text: 'Vérification HTTP périodique : code de réponse et temps de réponse.'},
            {icon: 'bi-exclamation-octagon', title: 'Détection des pannes', text: 'Incidents ouverts et résolus automatiquement, sans faux positifs.'},
            {icon: 'bi-globe2', title: 'Page de statut publique', text: 'Informez vos utilisateurs en temps réel, avec l\'historique de disponibilité.'},
            {icon: 'bi-code-slash', title: 'API REST', text: 'Toutes les fonctionnalités accessibles par API, documentée en OpenAPI.'},
        ] %}
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 p-3">
                    <i class="bi {{ feature.icon }} fs-2 text-success"></i>
                    <h2 class="h5 mt-2">{{ feature.title }}</h2>
                    <p class="text-secondary mb-0">{{ feature.text }}</p>
                </div>
            </div>
        {% endfor %}
    </section>
{% endblock %}
