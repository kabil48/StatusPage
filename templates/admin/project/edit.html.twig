{% extends 'base.html.twig' %}

{% block title %}Modifier {{ project.name }}{% endblock %}

{% block body %}
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_project_show', {id: project.id}) }}">{{ project.name }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">Modifier</li>
        </ol>
    </nav>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card p-4">
                <h1 class="h4 mb-4">Modifier le projet</h1>
                {{ include('admin/project/_form.html.twig', {button_label: 'Enregistrer'}) }}
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card p-4 border-danger">
                <h2 class="h6 text-danger">Zone de danger</h2>
                <p class="small text-secondary">La suppression efface définitivement le projet, ses services, l'historique des vérifications et les incidents.</p>
                <form method="post" action="{{ path('app_project_delete', {id: project.id}) }}" onsubmit="return confirm('Supprimer définitivement ce projet ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete-project-' ~ project.id) }}">
                    <button class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i> Supprimer le projet</button>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
