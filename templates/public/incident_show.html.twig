{% extends 'public/_layout.html.twig' %}
{% import '_partials/_macros.html.twig' as ui %}

{% block title %}{{ incident.title }} — {{ project.name }}{% endblock %}

{% block body %}
    <div class="mx-auto" style="max-width: 820px">
        <a href="{{ path('app_status_incidents', {slug: project.slug}) }}" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> Historique des incidents</a>

        <h1 class="h4 mt-2 mb-2">{{ incident.title }}</h1>
        <div class="d-flex flex-wrap align-items-center gap-2 small mb-4">
            {{ ui.incident_status_badge(incident.status) }}
            <span class="badge text-bg-{{ incident.impact.color }}">Impact {{ incident.impact.label|lower }}</span>
            <span class="text-secondary">
                Début {{ incident.startedAt|date('d/m/Y H:i') }}
                {% if incident.resolvedAt %}· durée {{ ui.duration(incident.durationInSeconds) }}{% endif %}
            </span>
        </div>

        {# RG-SEC-06 : seuls les services publics sont mentionnés #}
        {% set public_services = incident.affectedServices|filter(s => s.public) %}
        {% if public_services is not empty %}
            <p class="small text-secondary">
                Services concernés : {{ public_services|map(s => s.name)|join(', ') }}
            </p>
        {% endif %}

        <div class="card">
            <div class="card-body">
                {{ include('_partials/_incident_timeline.html.twig', {incident: incident}) }}
            </div>
        </div>
    </div>
{% endblock %}
