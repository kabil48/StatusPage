{% extends 'base.html.twig' %}
{% import '_partials/_macros.html.twig' as ui %}

{% block title %}Dashboard{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Bonjour {{ app.user.displayName }}</h1>
        <a href="{{ path('app_project_new') }}" class="btn btn-success"><i class="bi bi-plus-lg"></i> Nouveau projet</a>
    </div>

    <div class="row g-3 mb-4">
        {% for tile in [
            {label: 'Services surveillés', value: counters.services, color: 'dark'},
            {label: 'Services indisponibles', value: counters.down, color: counters.down > 0 ? 'danger' : 'dark'},
            {label: 'Services dégradés', value: counters.degraded, color: counters.degraded > 0 ? 'warning' : 'dark'},
            {label: 'Incidents ouverts', value: counters.open_incidents, color: counters.open_incidents > 0 ? 'danger' : 'dark'},
        ] %}
            <div class="col-6 col-lg-3">
                <div class="card stat-tile p-3">
                    <div class="text-secondary small mb-2">{{ tile.label }}</div>
                    <div class="value text-{{ tile.color }}">{{ tile.value }}</div>
                </div>
            </div>
        {% endfor %}
    </div>

    <h2 class="h5 mb-3">Mes projets</h2>

    {% if projects is empty %}
        <div class="card p-5 text-center">
            <i class="bi bi-folder-plus fs-1 text-secondary"></i>
            <p class="mt-3 mb-3">Vous n'avez encore aucun projet. Un projet correspond à une page de statut.</p>
            <div><a href="{{ path('app_project_new') }}" class="btn btn-success">Créer mon premier projet</a></div>
        </div>
    {% else %}
        <div class="row g-3">
            {% for project in projects %}
                {% set status = project_statuses[project.id] %}
                <div class="col-md-6 col-lg-4">
                    <a href="{{ path('app_project_show', {id: project.id}) }}" class="card h-100 p-3 text-decoration-none text-body">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            {{ ui.status_dot(status.color) }}
                            <span class="fw-semibold">{{ project.name }}</span>
                            {% if not project.public %}<span class="badge text-bg-light border ms-auto">Privé</span>{% endif %}
                        </div>
                        <div class="small text-secondary">{{ status.label }}</div>
                        <div class="small text-secondary mt-2">
                            <i class="bi bi-hdd-network"></i> {{ project.services|length }} service(s)
                        </div>
                    </a>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
